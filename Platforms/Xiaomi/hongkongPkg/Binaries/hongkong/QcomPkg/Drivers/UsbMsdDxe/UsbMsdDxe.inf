## @file
#  Prebuilt UsbMsdDxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = UsbMsdDxe
  FILE_GUID      = E6AAB023-AD2A-518B-9A94-ACAA5AB73A8F
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|UsbMsdDxe.efi

[Packages]
  MdePkg/MdePkg.dec
