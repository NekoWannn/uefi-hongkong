## @file
#  Prebuilt PlatformExceptionHandlerDxe, taken from the device's own firmware volume.
#
#  The stock a priori list dispatches this early; it has no source here, so the
#  .inf only declares the payload.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = PlatformExceptionHandlerDxe
  FILE_GUID      = 800F6C91-BA03-5185-BB52-7CC057D999FB
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|PlatformExceptionHandlerDxe.efi

[Packages]
  MdePkg/MdePkg.dec
