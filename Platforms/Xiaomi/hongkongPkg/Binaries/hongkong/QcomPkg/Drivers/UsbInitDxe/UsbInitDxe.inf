## @file
#  Prebuilt UsbInitDxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = UsbInitDxe
  FILE_GUID      = C6F7D9D1-C0E8-57E1-A09C-0199420A915B
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|UsbInitDxe.efi

[Packages]
  MdePkg/MdePkg.dec
