## @file
#  Prebuilt UsbMassStorageDxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = UsbMassStorageDxe
  FILE_GUID      = D0BA3423-4725-53CE-AEED-9494FA59A5C4
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|UsbMassStorageDxe.efi

[Packages]
  MdePkg/MdePkg.dec
