## @file
#  Prebuilt UsbDeviceDxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = UsbDeviceDxe
  FILE_GUID      = EA014785-8CAB-59FD-BD9C-8543CFA55C4A
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|UsbDeviceDxe.efi

[Packages]
  MdePkg/MdePkg.dec
