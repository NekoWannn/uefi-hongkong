## @file
#  Prebuilt UsbfnDwc3Dxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = UsbfnDwc3Dxe
  FILE_GUID      = FD5BC29D-519E-54DE-B0B6-A98C275DDAB7
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|UsbfnDwc3Dxe.efi

[Packages]
  MdePkg/MdePkg.dec
