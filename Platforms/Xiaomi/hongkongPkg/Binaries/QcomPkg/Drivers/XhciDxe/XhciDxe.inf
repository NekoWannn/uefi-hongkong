## @file
#  Prebuilt XhciDxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = XhciDxe
  FILE_GUID      = C36C9049-3DE3-5D6B-A7C8-33833A9D383D
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|XhciDxe.efi

[Packages]
  MdePkg/MdePkg.dec
