## @file
#  Prebuilt UsbConfigDxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = UsbConfigDxe
  FILE_GUID      = 10B1C7EF-BAE9-5EDE-B70C-6541ACA6827E
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|UsbConfigDxe.efi

[Packages]
  MdePkg/MdePkg.dec
