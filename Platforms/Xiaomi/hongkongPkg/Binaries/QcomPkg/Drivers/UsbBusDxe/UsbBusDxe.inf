## @file
#  Prebuilt UsbBusDxe taken from the device's own firmware volume.
#
#  There is no source for this driver, so the .inf only declares the binary and
#  how it loads. The payload keeps the DEPEX section UEFITool extracted with it.
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = UsbBusDxe
  FILE_GUID      = 179575D4-A2A8-5FB6-A1CD-1095D0156BF1
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries]
  PE32|UsbBusDxe.efi

[Packages]
  MdePkg/MdePkg.dec
